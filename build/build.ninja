build bin/client.exe: CXX_EXECUTABLE_LINKER__client_Debug modules/app/CMakeFiles/client.dir/src/client/app.cpp.obj modules/app/CMakeFiles/client.dir/src/client/networking/client.cpp.obj modules/app/CMakeFiles/client.dir/src/client/utils/cli.cpp.obj modules/app/CMakeFiles/client.dir/src/shared/layer/app.cpp.obj modules/app/CMakeFiles/client.dir/src/shared/layer/debug.cpp.obj modules/app/CMakeFiles/client.dir/src/shared/actor/base.cpp.obj modules/app/CMakeFiles/client.dir/src/shared/actor/ship.cpp.obj modules/app/CMakeFiles/client.dir/src/shared/actor/projectile.cpp.obj modules/app/CMakeFiles/client.dir/src/shared/config/settings.cpp.obj modules/app/CMakeFiles/client.dir/src/shared/eventhandler/eventhandler.cpp.obj modules/app/CMakeFiles/client.dir/src/shared/config/state.cpp.obj modules/app/CMakeFiles/client.dir/src/shared/networking/messages.cpp.obj modules/app/CMakeFiles/client.dir/src/shared/networking/clientconnection.cpp.obj | lib/sfml-graphics-s-d.lib lib/sfml-network-s-d.lib lib/sfml-system-s-d.lib lib/sfml-window-s-d.lib lib/spdlogd.lib lib/imgui.lib lib/dependencies.lib lib/core.lib lib/freetyped.lib || lib/core.lib lib/dependencies.lib lib/freetyped.lib lib/imgui.lib lib/sfml-graphics-s-d.lib lib/sfml-network-s-d.lib lib/sfml-system-s-d.lib lib/sfml-window-s-d.lib lib/spdlogd.lib
  CONFIG = Debug
  FLAGS = -g -gdwarf-4 -O0 -D_DEBUG -D_DLL -D_MT -Xclang --dependent-lib=msvcrtd -g -Xclang -gcodeview
  LINK_FLAGS = -Wl,-debug -Xlinker /subsystem:console -fuse-ld=lld-link
  LINK_LIBRARIES = lib/sfml-graphics-s-d.lib  lib/sfml-network-s-d.lib  lib/sfml-system-s-d.lib  lib/sfml-window-s-d.lib  lib/spdlogd.lib  lib/imgui.lib  lib/dependencies.lib  lib/core.lib  lib/freetyped.lib  -lws2_32.lib  -lwinmm.lib  -lopengl32.lib  -lgdi32.lib  -lkernel32 -luser32 -lgdi32 -lwinspool -lshell32 -lole32 -loleaut32 -luuid -lcomdlg32 -ladvapi32 -loldnames
  OBJECT_DIR = modules\app\CMakeFiles\client.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = modules\app\CMakeFiles\client.dir\
  TARGET_FILE = bin\client.exe
  TARGET_IMPLIB = lib\client.lib
  TARGET_PDB = bin\client.pdb


